# MongoDB connection string (from MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cinesnap?retryWrites=true&w=majority

# JWT secret — use a long random string
JWT_SECRET=your_super_secret_jwt_key_here

# Server port (Render sets this automatically; leave 5000 for local dev)
PORT=5000

# Optional: real email sending via Gmail App Password
# MAIL_USER=your@gmail.com
# MAIL_PASS=your_app_password
